#: kcm.cpp:78
msgid ""
"Unable to save settings because a temporary directory could not be created."
msgstr ""
"Impossible d'enregistrer la configuration car un dossier temporaire n'a pas "
"pu être créé."

#: kcm.cpp:139
msgid "Unable to save settings because the config could not be opened."
msgstr ""
"Impossible d'enregistrer la configuration car celle-ci n'a pas pu être "
"ouverte."

#: kcm.cpp:214
msgid ""
"Unable to synchronise Plasma settings because the 'plasmalogin' user does "
"not exist. Please check your Plasma Login install."
msgstr ""
"Impossible de synchroniser la configuration de Plasma car l'utilisateur "
"« plasmalogin » n'existe pas. Veuillez vérifier votre installation de "
"« Plasma Login »."

#: kcm.cpp:269
msgid ""
"Unable to reset Plasma settings because the 'plasmalogin' user does not "
"exist. Please check your Plasma Login install."
msgstr ""
"Impossible de réinitialiser la configuration de Plasma car l'utilisateur "
"« plasmalogin » n'existe pas. Veuillez vérifier votre installation de "
"« Plasma Login »."

