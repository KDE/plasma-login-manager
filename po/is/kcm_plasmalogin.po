#: kcm.cpp:83
msgid ""
"Unable to save settings because a temporary directory could not be created."
msgstr ""
"Tókst ekki að vista stillingar þar sem ekki tókst að útbúa bráðabirgðamöppu."

#: kcm.cpp:144
msgid "Unable to save settings because the config could not be opened."
msgstr ""
"Tókst ekki að vista stillingar þar sem ekki tókst að opna stillingaskrána."

#: kcm.cpp:219
msgid ""
"Unable to synchronise Plasma settings because the 'plasmalogin' user does "
"not exist. Please check your Plasma Login install."
msgstr ""
"Tókst ekki að samstilla stillingar Plasma þar sem notandinn 'plasmalogin' er "
"ekki til. Athugaðu uppsetninguna þína á Plasma Login."

#: kcm.cpp:301
msgid ""
"Unable to reset Plasma settings because the 'plasmalogin' user does not "
"exist. Please check your Plasma Login install."
msgstr ""
"Tókst ekki að endurstilla stillingar Plasma þar sem notandinn 'plasmalogin' "
"er ekki til. Athugaðu uppsetninguna þína á Plasma Login."

