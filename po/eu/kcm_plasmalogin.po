#: kcm.cpp:78
msgid ""
"Unable to save settings because a temporary directory could not be created."
msgstr ""
"Ez da ezarpenak gordetzeko gai aldi baterako direktorio bat ezin izan "
"duelako sortu."

#: kcm.cpp:139
msgid "Unable to save settings because the config could not be opened."
msgstr "Ez da ezarpenak gordetzeko gai konfigurazioa ezin izan duelako ireki."

#: kcm.cpp:214
msgid ""
"Unable to synchronise Plasma settings because the 'plasmalogin' user does "
"not exist. Please check your Plasma Login install."
msgstr ""
"Ez da Plasma ezarpenak sinkronizatzeko gai 'plasmalogin' erabiltzailea "
"existitzen ez delako. Mesedez, egiaztatu Plasman saio hasteko zure "
"instalazioa."

#: kcm.cpp:269
msgid ""
"Unable to reset Plasma settings because the 'plasmalogin' user does not "
"exist. Please check your Plasma Login install."
msgstr ""
"Ez da Plasma ezarpenak berrezartzeko gai 'plasmalogin' erabiltzailea "
"existitzen ez delako. Mesedez egiaztatu Plasman saio hasteko zure "
"instalazioa."

