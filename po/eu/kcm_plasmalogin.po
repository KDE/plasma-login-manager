#: ui/main.qml:64
#, kde-format
msgctxt "@title:window"
msgid "Apply Plasma Settings"
msgstr "Plasmaren ezarpenak aplikatu"

#: ui/main.qml:65
#, kde-format
msgid ""
"This will make the Plasma login screen reflect your customizations to the "
"following Plasma settings:"
msgstr ""
"Honen bidez, Plasmaren saioa hasteko pantailak Plasmaren ondoko ezarpenetan "
"egin dituzun moldaketak islatuko ditu:"

#: ui/main.qml:66
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para><list><item>Language and locale settings</item><item>Keyboard layouts</"
"item><item>Screen arrangement, scale, and orientation settings</"
"item><item>NumLock preference</item><item>Font and font rendering settings</"
"item><item>Color scheme</item><item>Cursor theme and size</item><item>Plasma "
"theme</item></list></para>"
msgstr ""
"<para><list><item>Hizkuntza- eta eskualde-ezarpenak</item><item>Teklatu-"
"antolaerak</item><item>Pantailen antolaeraren, eskalaren eta orientazioaren "
"ezarpenak</item><item>ZkGiltz hobespena</item><item>Letra-tipoen eta haien "
"errendatzearen ezarpenak</item><item>Kolore-antolaera</"
"item><item>Kurtsorearen gaia eta neurria</item><item>Plasma gaia</item></"
"list></para>"

#: ui/main.qml:67
#, kde-format
msgid ""
"Please note that theme and font files must be installed globally to be "
"reflected on the Plasma login screen."
msgstr ""
"Kontuan izan Plasmaren saioa hasteko pantailan islatu daitezen, gaien eta "
"letra-tipoen fitxategiak sistema osorako instalatu behar direla."

#: ui/main.qml:71
#, kde-format
msgctxt "@action:button"
msgid "Apply"
msgstr "Aplikatu"

#: ui/main.qml:76
#, kde-format
msgctxt "@action:button"
msgid "Reset to Default Settings"
msgstr "Lehenetsitako ezarpenetara berrezarri"

#: ui/main.qml:86
#, kde-format
msgctxt "@title:group"
msgid "Auto-login"
msgstr "Saioa automatikoki hastea"

#: ui/main.qml:89
#, kde-format
msgctxt ""
"part of a sentence: 'Automatically log in [as user: foo / with session: bar]'"
msgid "Automatically log in:"
msgstr "Saioa automatikoki hasi:"

#: ui/main.qml:103
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: '[Automatically log in] as user: [foo / "
"with session: bar]'"
msgid "as user:"
msgstr "erabiltzaile honen gisa:"

#: ui/main.qml:127
#, kde-format
msgid "Automatically log in with a specific user and session"
msgstr "Erabiltzaile eta saio jakin batekin saioa automatikoki hasi"

#: ui/main.qml:149
#, kde-format
msgid "Select a user for automatic log in"
msgstr "Saioa automatikoki hasteko erabiltzaile bat hautatu"

#: ui/main.qml:161
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: '[Automatically log in as user: foo / ] "
"with session: [bar]'"
msgid "with session:"
msgstr "saio honekin:"

#: ui/main.qml:183
#, kde-format
msgid "Select a session for automatic log in"
msgstr "Saioa automatikoki hasteko saio bat hautatu"

#: ui/main.qml:195
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Auto-login does not support unlocking your KDE Wallet automatically, so it "
"will ask you to unlock it every time you log in.<nl/><nl/>To avoid this, you "
"can change the wallet to have a blank password. Note that this is insecure "
"and should only be done in a trusted environment."
msgstr ""
"Saioa automatikoki hasteak ez du KDE Zorroa giltzapetik automatikoki "
"askatzea onartzen; beraz, saioa hasten duzun bakoitzean hura giltzapetik "
"askatzeko eskatuko dizu.<nl/><nl/>Hori saihesteko, zorroaren pasahitza "
"hutsik utz dezakezu. Kontuan izan hori ez dela segurua eta konfiantzazko "
"ingurune batean baino ez litzatekeela egin behar."

#: ui/main.qml:200
#, kde-format
msgid "Open KDE Wallet Settings"
msgstr "KDE Zorroaren ezarpenak ireki"

#: ui/main.qml:210
#, kde-format
msgctxt "@option:check"
msgid "Log in again immediately after logging off"
msgstr "Saioa amaitu ondoren berehala berriz hasi"

#: ui/main.qml:224
#, kde-format
msgctxt "@title:group"
msgid "Defaults"
msgstr "Lehenespenak"

#: ui/main.qml:227
#, kde-format
msgid "Default user:"
msgstr "Erabiltzaile lehenetsia:"

#: ui/main.qml:235
#, kde-format
msgctxt "@option:radio"
msgid "Last logged-in user"
msgstr "Saioa hasi zuen azken erabiltzailea"

#: ui/main.qml:295
#, kde-format
msgid "Select the default user to be shown at the login screen"
msgstr "Saioa hasteko pantailan erakutsiko den erabiltzaile lehenetsia hautatu"

#: ui/main.qml:303
#, kde-format
msgid "Default session:"
msgstr "Saio lehenetsia:"

#: ui/main.qml:311
#, kde-format
msgctxt "@option:radio"
msgid "Last logged-in session"
msgstr "Erabilitako azken saioa"

#: ui/main.qml:369
#, kde-format
msgid "Select the default session to be shown at the login screen"
msgstr "Saioa hasteko pantailan erakutsiko den saio lehenetsia hautatu"
