#: kcm.cpp:78
msgid ""
"Unable to save settings because a temporary directory could not be created."
msgstr ""
"Ezarpenak ezin izan dira gorde, aldi baterako direktorio bat ezin izan "
"delako sortu."

#: kcm.cpp:139
msgid "Unable to save settings because the config could not be opened."
msgstr "Ezarpenak ezin izan dira gorde, konfigurazioa ezin izan delako ireki."

#: kcm.cpp:214
msgid ""
"Unable to synchronise Plasma settings because the 'plasmalogin' user does "
"not exist. Please check your Plasma Login install."
msgstr ""
"Plasmaren ezarpenak ezin izan dira sinkronizatu, «plasmalogin» erabiltzailea "
"existitzen ez delako. Mesedez, egiaztatu zure Plasma Login instalazioa."

#: kcm.cpp:269
msgid ""
"Unable to reset Plasma settings because the 'plasmalogin' user does not "
"exist. Please check your Plasma Login install."
msgstr ""
"Plasmaren ezarpenak ezin izan dira berrezarri, «plasmalogin» erabiltzailea "
"existitzen ez delako. Mesedez, egiaztatu zure Plasma Login instalazioa."

