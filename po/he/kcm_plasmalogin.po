#: ui/main.qml:65
#, kde-format
msgid ""
"This will make the Plasma login screen reflect your customizations to the "
"following Plasma settings:"
msgstr ""
"הגדרה זו תגרום למסך הכניסה אל פלזמה לשקף את ההתאמות שלך להגדרות הפלזמה הבאות:"

#: ui/main.qml:66
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para><list><item>Language and locale settings</item><item>Keyboard layouts</"
"item><item>Screen arrangement, scale, and orientation settings</"
"item><item>NumLock preference</item><item>Font and font rendering settings</"
"item><item>Color scheme</item><item>Cursor theme and size</item><item>Plasma "
"theme</item></list></para>"
msgstr ""
"<para><list><item>הגדרות שפה ומקום</item><item>פריסות מקלדת</"
"item><item>הגדרות סידור מסכים, קנה מידה וכיוון</item><item>העדפת NumLock</"
"item><item>הגדרות גופנים ותיצוג גופנים</item><item>ערכת צבעים</"
"item><item>גודל וערכת מצביעים</item><item>ערכת עיצוב של פלזמה</item></list></"
"para>"

#: ui/main.qml:67
#, kde-format
msgid ""
"Please note that theme and font files must be installed globally to be "
"reflected on the Plasma login screen."
msgstr ""
"נא לשים לב שיש להתקין את קובצי ערכת העיצוב והגופנים באופן מקיף כדי שישפיע על "
"מסך הכניסה לפלזמה."

