#, kde-format
msgid "Automatically log in with a specific user and session"
msgstr "Automatsko prijavljivanje sa zadatim korisnikom i sesijom"

#: ui/main.qml:149
#, kde-format
msgid "Select a user for automatic log in"
msgstr "Izaberite korisnika za automatsko prijavljivanje"

