#: ui/main.qml:64
#, kde-format
msgctxt "@title:window"
msgid "Apply Plasma Settings"
msgstr "Uveljavi nastavitve Plasme"

#: ui/main.qml:65
#, kde-format
msgid ""
"This will make the Plasma login screen reflect your customizations to the "
"following Plasma settings:"
msgstr ""
"S tem bo prijavni zaslon Plasma odražala prilagoditve naslednjih nastavitev "
"Plasme:"

#: ui/main.qml:66
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para><list><item>Language and locale settings</item><item>Keyboard layouts</"
"item><item>Screen arrangement, scale, and orientation settings</"
"item><item>NumLock preference</item><item>Font and font rendering settings</"
"item><item>Color scheme</item><item>Cursor theme and size</item><item>Plasma "
"theme</item></list></para>"
msgstr ""
"<para><list><item>Nastavitve jezika in področnih nastavitev</"
"item><item>Razporeditve tipkovnice</item><item>Nastavitve razporeditve, "
"merila in orientacije zaslona</item><item>Nastavitve NumLock</"
"item><item>Nastavitve pisave in upodabljanja pisave</item><item>Barvna "
"shema</item><item>Tema in velikost kazalca</item><item>Tema Plasme</item></"
"list></para>"

#: ui/main.qml:67
#, kde-format
msgid ""
"Please note that theme and font files must be installed globally to be "
"reflected on the Plasma login screen."
msgstr ""
"Upoštevajte, da morajo biti datoteke teme in pisav nameščene globalno, da se "
"odražajo na prijavnem zaslonu Plasme."

#: ui/main.qml:71
#, kde-format
msgctxt "@action:button"
msgid "Apply"
msgstr "Uveljavi"

#: ui/main.qml:76
#, kde-format
msgctxt "@action:button"
msgid "Reset to Default Settings"
msgstr "Ponastavi na privzete nastavitve"

#: ui/main.qml:86
#, kde-format
msgctxt "@title:group"
msgid "Auto-login"
msgstr "Samodejna prijava"

#: ui/main.qml:89
#, kde-format
msgctxt ""
"part of a sentence: 'Automatically log in [as user: foo / with session: bar]'"
msgid "Automatically log in:"
msgstr "Samodejna prijava:"

#: ui/main.qml:103
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: '[Automatically log in] as user: [foo / "
"with session: bar]'"
msgid "as user:"
msgstr "kot uporabnik:"

#: ui/main.qml:127
#, kde-format
msgid "Automatically log in with a specific user and session"
msgstr "Samodejna prijava z določenim uporabnikom in sejo"

#: ui/main.qml:149
#, kde-format
msgid "Select a user for automatic log in"
msgstr "Izberite uporabnika za samodejno prijavo."

#: ui/main.qml:161
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: '[Automatically log in as user: foo / ] "
"with session: [bar]'"
msgid "with session:"
msgstr "s sejo:"

#: ui/main.qml:183
#, kde-format
msgid "Select a session for automatic log in"
msgstr "Izberite sejo za samodejno prijavo."

#: ui/main.qml:195
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Auto-login does not support unlocking your KDE Wallet automatically, so it "
"will ask you to unlock it every time you log in.<nl/><nl/>To avoid this, you "
"can change the wallet to have a blank password. Note that this is insecure "
"and should only be done in a trusted environment."
msgstr ""
"Samodejna prijava ne podpira samodejnega odklepanja vaše listnice KDE (KDE "
"Wallet), zato jo boste morali ob vsaki prijavi odkleniti ročno.<nl/><nl/"
">Temu se lahko izognete tako, da za listnico nastavite prazno geslo. "
"Upoštevajte, da to ni varno in je priporočljivo le v zaupanja vrednem okolju."

#: ui/main.qml:200
#, kde-format
msgid "Open KDE Wallet Settings"
msgstr "Odprite nastavitve denarnice KDE Wallet"

#: ui/main.qml:210
#, kde-format
msgctxt "@option:check"
msgid "Log in again immediately after logging off"
msgstr "Po odjavi se takoj znova prijavite"

#: ui/main.qml:224
#, kde-format
msgctxt "@title:group"
msgid "Defaults"
msgstr "Privzeto"

#: ui/main.qml:227
#, kde-format
msgid "Default user:"
msgstr "Privzeti uporabnik:"

#: ui/main.qml:235
#, kde-format
msgctxt "@option:radio"
msgid "Last logged-in user"
msgstr "Zadnje prijavljeni uporabnik"

#: ui/main.qml:295
#, kde-format
msgid "Select the default user to be shown at the login screen"
msgstr "Izberite privzetega uporabnika, ki bo prikazan na zaslonu za prijavo."

#: ui/main.qml:303
#, kde-format
msgid "Default session:"
msgstr "Privzeta seja:"

#: ui/main.qml:311
#, kde-format
msgctxt "@option:radio"
msgid "Last logged-in session"
msgstr "Zadnja prijavljena seja"

#: ui/main.qml:369
#, kde-format
msgid "Select the default session to be shown at the login screen"
msgstr "Izberite privzeto sejo, ki naj bo prikazana na zaslonu za prijavo."

