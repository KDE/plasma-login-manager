#: kcm.cpp:78
msgid ""
"Unable to save settings because a temporary directory could not be created."
msgstr "تەڭشەكنى ساقلىغىلى بولمىدى چۈنكى ۋاقىتلىق مۇندەرىجە قۇرغىلى بولمىدى."

#: kcm.cpp:139
msgid "Unable to save settings because the config could not be opened."
msgstr "تەڭشەكنى ساقلىغىلى بولمىدى چۈنكى سەپلىمىنى ئاچقىلى بولمىدى."

#: kcm.cpp:214
msgid ""
"Unable to synchronise Plasma settings because the 'plasmalogin' user does "
"not exist. Please check your Plasma Login install."
msgstr ""
"Plasma تەڭشەكنى قەدەمداشلىغىلى بولمىدى چۈنكى «plasmalogin» ئىشلەتكۈچى مەۋجۇت "
"ئەمەس. Plasma تىزىمغا كىرىشنى ئورناتقانلىقىڭىزنى تەكشۈرۈڭ."

#: kcm.cpp:269
msgid ""
"Unable to reset Plasma settings because the 'plasmalogin' user does not "
"exist. Please check your Plasma Login install."
msgstr ""
"Plasma تەڭشەكنى ئەسلىگە قايتۇرغىلى بولمىدى چۈنكى «plasmalogin» ئىشلەتكۈچى "
"مەۋجۇت ئەمەس. Plasma تىزىمغا كىرىشنى ئورناتقانلىقىڭىزنى تەكشۈرۈڭ."

