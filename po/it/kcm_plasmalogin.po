#: ui/main.qml:64
#, kde-format
msgctxt "@title:window"
msgid "Apply Plasma Settings"
msgstr "Applica le impostazioni Plasma"

#: ui/main.qml:65
#, kde-format
msgid ""
"This will make the Plasma login screen reflect your customizations to the "
"following Plasma settings:"
msgstr ""
"In questo modo la schermata di accesso a Plasma rifletterà le tue "
"personalizzazioni alle seguenti impostazioni di Plasma:"

#: ui/main.qml:66
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para><list><item>Language and locale settings</item><item>Keyboard layouts</"
"item><item>Screen arrangement, scale, and orientation settings</"
"item><item>NumLock preference</item><item>Font and font rendering settings</"
"item><item>Color scheme</item><item>Cursor theme and size</item><item>Plasma "
"theme</item></list></para>"
msgstr ""
"<para><list><item>Lingua e impostazioni locali</item><item>Disposizioni "
"tastiera</item><item>Impostazioni di disposizione, scala e orientazione "
"schermo</item><item>Preferenza BlocNum</item><item>Impostazioni dei "
"caratteri e resa caratteri</item><item>Schema di colori</item><item>Tema e "
"dimensione cursore</item><item>Tema di Plasma</item></list></para>"

#: ui/main.qml:67
#, kde-format
msgid ""
"Please note that theme and font files must be installed globally to be "
"reflected on the Plasma login screen."
msgstr ""
"Nota che, affinché siano riproposti nella schermata di accesso a Plasma, i "
"file del tema e del tipo di carattere devono essere installati a livello "
"globale."

#: ui/main.qml:71
#, kde-format
msgctxt "@action:button"
msgid "Apply"
msgstr "Applica"

#: ui/main.qml:76
#, kde-format
msgctxt "@action:button"
msgid "Reset to Default Settings"
msgstr "Ripristina alle impostazioni predefinite"

