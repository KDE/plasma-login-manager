msgstr "Accesso automatico"

#: ui/main.qml:89
#, kde-format
msgctxt ""
"part of a sentence: 'Automatically log in [as user: foo / with session: bar]'"
msgid "Automatically log in:"
msgstr "Accedi automaticamente:"

#: ui/main.qml:103
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: '[Automatically log in] as user: [foo / "
"with session: bar]'"
msgid "as user:"
msgstr "come utente:"

#: ui/main.qml:127
#, kde-format
msgid "Automatically log in with a specific user and session"
msgstr "Accedi automaticamente con un utente e una sessione specifica"

#: ui/main.qml:149
#, kde-format
msgid "Select a user for automatic log in"
msgstr "Seleziona un utente per l'accesso automatico"

#: ui/main.qml:161
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: '[Automatically log in as user: foo / ] "
"with session: [bar]'"
msgid "with session:"
msgstr "con sessione:"

#: ui/main.qml:183
#, kde-format
msgid "Select a session for automatic log in"
msgstr "Seleziona una sessione per l'accesso automatico"

#: ui/main.qml:195
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Auto-login does not support unlocking your KDE Wallet automatically, so it "
"will ask you to unlock it every time you log in.<nl/><nl/>To avoid this, you "
"can change the wallet to have a blank password. Note that this is insecure "
"and should only be done in a trusted environment."
msgstr ""
"L'accesso automatico non supporta lo sblocco automatico del tuo Portafoglio "
"KDE, pertanto ti verrà chiesto di sbloccarlo ogni volta che accedi.<nl/><nl/"
">Per evitare questo comportamento, puoi modificare il portafoglio in modo da "
"avere una password vuota. Nota che questa operazione non è sicura e deve "
"essere eseguita soltanto all'interno di un ambiente affidabile."

#: ui/main.qml:200
#, kde-format
