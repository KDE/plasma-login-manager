#, kde-format
msgctxt ""
"@label:listbox part of a sentence: '[Automatically log in] as user: [foo / "
"with session: bar]'"
msgid "as user:"
msgstr "као корисник:"

#: ui/main.qml:127
#, kde-format
msgid "Automatically log in with a specific user and session"
msgstr "Аутоматско пријављивање са задатим корисником и сесијом"

#: ui/main.qml:149
#, kde-format
msgid "Select a user for automatic log in"
msgstr "Изаберите корисника за аутоматско пријављивање"

